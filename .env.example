# ErasmusPlus — ortam değişkenleri örneği
# Bu dosyayı `.env` olarak kopyalayıp gerçek anahtarlarınızı girin.
# GERÇEK ANAHTARLARI BURAYA YAZMAYIN — .env dosyası .gitignore'dadır.

# Telegram bot token'ı (@BotFather'dan alınır)
TELEGRAM_BOT_TOKEN=

# Groq API anahtarı (Llama-3.3 çıkarımı için)
GROQ_API_KEY=

# OpenAI API anahtarı (text-embedding-3-small embedding'leri için)
OPENAI_API_KEY=
